NEXT_PUBLIC_GITCOIN_SCORER_ID=your_gitcoin_scorer_id
GITCOIN_PASSPORT_API_KEY=your_gitcoin_passport_api_key

# zkPass (Zero-Knowledge Credential Verification)
NEXT_PUBLIC_ZKPASS_APP_ID=your_zkpass_app_id
ZKPASS_API_KEY=your_zkpass_api_key
ZKPASS_SCHEMA_ID=your_zkpass_schema_id

# zKYC.tech (Regulatory KYC with SBT)
