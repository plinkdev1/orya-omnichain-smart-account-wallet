# ============================================================================
# ORŸA WALLET - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================================

# ============================================================================
# 1️⃣ DATABASE & CACHE LAYER
# ============================================================================
DATABASE_URL=postgresql://orya_user:dev_password_123@localhost:5432/orya_dev
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30
NEON_URL=postgresql://user:password@ep-example.neon.tech/orya_db
NEON_KEY=your_neon_api_key
REDIS_URL=redis://:redis_password_123@localhost:6379
REDIS_PASSWORD=redis_password_123
REDIS_DB=0
REDIS_KEY_EXPIRY=300

# ============================================================================
# 2️⃣ RPC PROVIDERS & BLOCKCHAIN NODES
# ============================================================================
# Alchemy (Primary - supports EVM, SUI, Solana)
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_NFT_KEY=your_alchemy_nft_key_here

# QuickNode (Fallback)
QUICKNODE_API_KEY=your_quicknode_api_key_here

# Infura (Optional ETH/L2)
INFURA_API_KEY=your_infura_api_key_here

# Chain-Specific RPC Endpoints
SUI_RPC_URL=https://fullnode.devnet.sui.io
SUI_RPC_KEY=your_sui_rpc_key
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_KEY=your_solana_rpc_key

# Bitcoin & BTCfi
THORCHAIN_API_KEY=your_thorchain_api_key
BITLAYER_API_KEY=your_bitlayer_api_key
STACKS_API_KEY=your_stacks_api_key

# Cross-Chain Bridges
LAYERZERO_API_KEY=your_layerzero_api_key
HOP_API_KEY=your_hop_api_key
AXELAR_API_KEY=your_axelar_api_key
WORMHOLE_API_KEY=your_wormhole_api_key

# ============================================================================
# 3️⃣ DEFI & PROTOCOL SDKs
# ============================================================================
# DEX Aggregators & Swaps
ZEROX_API_KEY=your_0x_api_key
ZEROX_RELAYER_KEY=your_0x_relayer_key
ONEBALANCE_API_KEY=your_onebalance_api_key

# Wallet & Auth Infrastructure
PRIVY_API_KEY=your_privy_api_key
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
PRIVY_KYC_KEY=your_privy_kyc_key
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
REOWN_KEY=your_reown_key

# ============================================================================
# IKA 2PC-MPC Zero-Trust Architecture (Phase 3.D - CORRECTED)
# ============================================================================
# NOTE: IKA is a DECENTRALIZED on-chain protocol on Sui
# NO API KEYS REQUIRED - everything happens on-chain via Sui transactions
# ============================================================================
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io
# Optional: Custom RPC for better performance
# NEXT_PUBLIC_SUI_RPC_URL=https://your-custom-rpc.com

# Default wallet type for new users (standard | enhanced | human-network)
DEFAULT_WALLET_TYPE=enhanced

# Enable IKA zero-trust features for power users
ENABLE_IKA_ZERO_TRUST=true

# Oracles & Price Feeds
CHAINLINK_API_KEY=your_chainlink_api_key
PYTH_API_KEY=your_pyth_api_key
REDSTONE_API_KEY=your_redstone_api_key

