# =============================================================================
# EVM ADAPTER - ENVIRONMENT VARIABLES
# =============================================================================

# RPC Endpoints (Alchemy Cortex)
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_BASE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_ARBITRUM_RPC=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_OPTIMISM_RPC=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Fallback RPC (QuickNode)
QUICKNODE_API_KEY=your_quicknode_api_key_here
QUICKNODE_ETH_RPC=https://example.eth-mainnet.quiknode.pro/YOUR_KEY

# Ethereum Mainnet
ETHEREUM_CHAIN_ID=1
ETHEREUM_NETWORK_NAME=ethereum

# Layer 2 Chains
BASE_CHAIN_ID=8453
BASE_NETWORK_NAME=base

ARBITRUM_CHAIN_ID=42161
ARBITRUM_NETWORK_NAME=arbitrum

OPTIMISM_CHAIN_ID=10
OPTIMISM_NETWORK_NAME=optimism

POLYGON_CHAIN_ID=137
POLYGON_NETWORK_NAME=polygon

# DEX Aggregators
ZEROX_API_KEY=your_zerox_api_key_here
ONEINCH_API_KEY=your_oneinch_api_key_here

# Logging
LOG_LEVEL=debug