# =============================================================================
# SUI ADAPTER - ENVIRONMENT VARIABLES
# =============================================================================

# SUI Network Configuration
SUI_NETWORK=devnet                    # mainnet | testnet | devnet
SUI_RPC_URL=https://fullnode.devnet.sui.io
SUI_CHAIN_ID=sui:devnet
SUI_PACKAGE_ID=your_sui_package_id_here

# DeepBook Configuration
SUI_DEEPBOOK_POOL_ID=your_deepbook_pool_id_here
SUI_DEEPBOOK_API_KEY=your_deepbook_api_key_here

# Protocol IDs (SUI ecosystem)
SUI_CETUS_POOL_ID=your_cetus_pool_id_here
SUI_SUILEND_POOL_ID=your_suilend_pool_id_here
SUI_SCALLOP_POOL_ID=your_scallop_pool_id_here
SUI_AFTERMATH_POOL_ID=your_aftermath_pool_id_here

# Wallet Configuration
SUI_WALLET_ADDRESS=your_wallet_address_here
SUI_KEYSTORE_PATH=/path/to/keystore

# Logging
LOG_LEVEL=debug
RUST_LOG=debug,sui_adapter=trace