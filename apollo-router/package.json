{
  "name": "@orya/apollo-router",
  "version": "1.0.0",
  "description": "Apollo Router Federation Gateway for ORYA Wallet - Unified GraphQL API",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "compose": "rover supergraph compose --config ./supergraph-config.yaml --output ./supergraph.graphql",
    "graph:publish": "rover graph publish ${APOLLO_GRAPH_REF} --schema ./supergraph.graphql",
    "graph:check": "rover graph check ${APOLLO_GRAPH_REF} --schema ./supergraph.graphql"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "axios": "^1.6.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.1.2",
    "firebase-admin": "^12.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/jsonwebtoken": "^9.0.5",
    "typescript": "^5.3.2",
    "tsx": "^4.7.0",
    "vitest": "^1.0.4",
    "@types/vitest": "^0.34.6",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
