# Firebase Configuration - MANDATORY
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_ENABLED=true

# Firebase Emulator (Development Only)
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_FIREBASE_EMULATOR_AUTH_PORT=9099
EXPO_PUBLIC_FIREBASE_EMULATOR_DB_PORT=8080

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:3000/graphql
EXPO_PUBLIC_API_TIMEOUT=30000

# Blockchain Configuration
EXPO_PUBLIC_PRIMARY_CHAIN=sui
EXPO_PUBLIC_SUI_RPC_URL=https://fullnode.devnet.sui.io
EXPO_PUBLIC_ETH_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/your_key_here
EXPO_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Feature Flags
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=false
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true

# Debug Configuration (Development Only)
EXPO_PUBLIC_VERBOSE_LOGGING=false
EXPO_PUBLIC_ENABLE_REDUX_DEVTOOLS=false
EXPO_PUBLIC_ENABLE_NETWORK_MONITORING=false

# Build Configuration
EXPO_PUBLIC_BUILD_NUMBER=1
NODE_ENV=development