# Database Configuration
# For local development with Docker Compose:
DATABASE_URL=postgresql://orya_user:dev_password_123@localhost:5432/orya_dev

# For Neon PostgreSQL (serverless):
# DATABASE_URL=postgresql://[user]:[password]@[host].neon.tech:5432/[database]?sslmode=require

# For SQLx compile-time query verification:
# Set this to skip compile-time checks (useful in CI/CD without database access)
# SQLX_OFFLINE=true

# Redis Configuration
REDIS_URL=redis://:redis_password_123@localhost:6379

# Service Ports
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
TRANSACTION_SERVICE_PORT=3002
PORTFOLIO_SERVICE_PORT=3003
WALLET_SERVICE_PORT=3004
PLUGIN_SERVICE_PORT=3017

# Logging
RUST_LOG=info,api_gateway=debug

# Environment
ENV=development
