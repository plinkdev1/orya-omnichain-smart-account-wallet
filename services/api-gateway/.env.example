USER_SERVICE_PORT=3002
TRANSACTION_SERVICE_PORT=3003
PORTFOLIO_SERVICE_PORT=3004
DEFI_SERVICE_PORT=3005
FRAUD_ENGINE_PORT=3006

# GraphQL Apollo Router
APOLLO_ROUTER_PORT=4000

# NATS Message Bus
NATS_URL=nats://localhost:4222

# API Keys for External Services
ALCHEMY_API_KEY=API key - Nssxd3ox6QbFUYL2DA1N-
