# Server Configuration
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=3000
API_BASE_URL=http://localhost:3000

# Environment
NODE_ENV=development
LOG_LEVEL=debug
RUST_LOG=debug,api_gateway=trace

# Database (PostgreSQL)
DATABASE_URL=postgresql://orya_user:dev_password_123@localhost:5432/orya_dev
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30

# Redis (Cache & Rate Limiting)
REDIS_URL=redis://:redis_password_123@localhost:6379
REDIS_PASSWORD=redis_password_123
REDIS_DB=0

# JWT Configuration
JWT_SECRET=dev_jwt_secret_change_in_production_very_long_secret_key
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production
JWT_REFRESH_EXPIRY=7d

# Microservice Ports (for routing)
