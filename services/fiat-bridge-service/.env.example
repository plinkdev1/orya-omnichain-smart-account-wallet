# =============================================================================
# FIAT BRIDGE SERVICE - ENVIRONMENT VARIABLES
# =============================================================================

# Server Configuration
FIAT_BRIDGE_SERVICE_PORT=3011
HOST=0.0.0.0

# Environment
NODE_ENV=development
LOG_LEVEL=debug
RUST_LOG=debug,fiat_bridge_service=trace

# Database (PostgreSQL)
DATABASE_URL=postgresql://orya_user:dev_password_123@localhost:5432/orya_dev
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30

# Redis (Cache & Session Management)
REDIS_URL=redis://:redis_password_123@localhost:6379
REDIS_PASSWORD=redis_password_123
REDIS_DB=0

# NATS Message Bus
NATS_URL=nats://localhost:4222

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_test_YOUR_WEBHOOK_SECRET_HERE
STRIPE_IS_PRODUCTION=false

# MoonPay Configuration
MOONPAY_API_KEY=YOUR_MOONPAY_API_KEY_HERE
MOONPAY_SECRET_KEY=YOUR_MOONPAY_SECRET_KEY_HERE
MOONPAY_WEBHOOK_SECRET=YOUR_MOONPAY_WEBHOOK_SECRET_HERE

# Ramp Configuration
RAMP_API_KEY=YOUR_RAMP_API_KEY_HERE
RAMP_SECRET_KEY=YOUR_RAMP_SECRET_KEY_HERE

# FX Conversion & External APIs
FX_API_KEY=YOUR_FX_API_KEY_HERE
FX_API_URL=https://api.exchangerate-api.com/v4/latest/

# Observability
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
PROMETHEUS_ENABLED=true

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:3011

# Feature Flags
ENABLE_STRIPE=true
ENABLE_MOONPAY=true
ENABLE_RAMP=true
ENABLE_WEBHOOK_VALIDATION=true
