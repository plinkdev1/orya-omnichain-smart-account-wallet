# Protocol Service Configuration

# Server
PROTOCOL_SUBGRAPH_PORT=4004
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/orya_wallet

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# JWT
JWT_SECRET=your-jwt-secret-key

# Monitoring
SENTRY_DSN=

# Protocol Registry (optional - for external lookups)
PROTOCOL_REGISTRY_URL=
PROTOCOL_REGISTRY_API_KEY=
