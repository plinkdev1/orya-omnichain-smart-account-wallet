# ============================================================================
# ORYA Wallet Service - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orya_wallet

# Connection pool settings
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_TIMEOUT_SECONDS=30

# ============================================================================
# ENCRYPTION CONFIGURATION
# ============================================================================
# CRITICAL: Generate a secure 256-bit (64 hex characters) encryption key
# Generate using: openssl rand -hex 32
# This key encrypts all private keys before storage
# NEVER share or commit this key!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================================================
# PRIVY CONFIGURATION
# ============================================================================
# Privy provides MPC embedded wallets for HUMAN_NETWORK type wallets
# Sign up at: https://console.privy.io/

# Your Privy API Key (found in Privy dashboard)
PRIVY_API_KEY=privy_api_key_here_change_me

# Privy API Base URL (don't change unless using different environment)
PRIVY_BASE_URL=https://api.privy.io

# ============================================================================
# TATUM CONFIGURATION
# ============================================================================
# Tatum provides multi-chain wallet generation for OWNED type wallets
# Sign up at: https://tatum.io/

# Your Tatum API Key (found in Tatum dashboard)
TATUM_API_KEY=tatum_api_key_here_change_me

# Tatum API Base URL for v3 endpoints
TATUM_BASE_URL=https://api.tatum.io/v3

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
# Port to listen on (default 3003 for wallet-service)
SERVICE_PORT=3003

# Logging level (trace, debug, info, warn, error)
LOG_LEVEL=info
RUST_LOG=wallet_service=debug,axum=info

# ============================================================================
# EXTERNAL SERVICES (Optional)
# ============================================================================
# Redis configuration for caching
REDIS_URL=redis://localhost:6379

# Metrics/Monitoring
PROMETHEUS_PORT=9090

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
# Enable development features (DO NOT USE IN PRODUCTION)
DEV_MODE=false

# Mock API responses (for testing without real APIs)
USE_MOCK_TATUM=false
USE_MOCK_PRIVY=false

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# Allow plain HTTP (development only)
ALLOW_HTTP=false

# CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=10

# ============================================================================
# NOTES
# ============================================================================
# 1. ENCRYPTION_KEY: Must be exactly 64 hex characters (32 bytes)
#    - Test key generation: openssl rand -hex 32
#    - Store securely in production (use AWS Secrets Manager, etc.)
#
# 2. API Keys: Get these from service dashboards
#    - Privy: https://console.privy.io/dashboard/credentials
#    - Tatum: https://dashboard.tatum.io/account
#
# 3. DATABASE_URL Format:
#    postgresql://[user]:[password]@[host]:[port]/[database]
#
# 4. For production, use environment variable management:
#    - AWS Secrets Manager
#    - HashiCorp Vault
#    - Azure Key Vault
#    - Google Cloud Secret Manager