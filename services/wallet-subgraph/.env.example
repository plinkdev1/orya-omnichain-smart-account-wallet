# Server Config
WALLET_SUBGRAPH_PORT=4001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/orya_wallet

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RPC Providers
ALCHEMY_API_KEY=your_alchemy_key
QUICKNODE_API_KEY=your_quicknode_key
ZAN_API_KEY=your_zan_key
INFURA_API_KEY=your_infura_key
ANKR_API_KEY=your_ankr_key

# NFT API
ALCHEMY_NFT_API_KEY=your_alchemy_nft_key

# Authentication
JWT_SECRET=your_jwt_secret
PRIVY_APP_ID=your_privy_app_id

# Chain Configuration
SUPPORTED_CHAINS=sui,ethereum,base,polygon,arbitrum,optimism,solana,bitcoin,avalanche,bsc,aptos,stacks,bitlayer

# Feature Flags
ENABLE_PRIVY=true
ENABLE_NFT_SYNC=true
ENABLE_BALANCE_SYNC=true
