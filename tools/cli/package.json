{
  "name": "@orya/cli",
  "version": "0.1.0",
  "description": "ORŸA Wallet CLI Scaffolding Tool for adapter generation",
  "type": "module",
  "bin": {
    "orya-cli": "./dist/main.js"
  },
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "dev": "ts-node src/main.ts",
    "build": "tsup",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
